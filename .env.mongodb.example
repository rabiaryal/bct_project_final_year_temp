# MongoDB Atlas Configuration (REQUIRED)
# Copy this file to .env.mongodb and fill in your credentials:
#   cp .env.mongodb.example .env.mongodb

# MongoDB Atlas Connection String (REQUIRED)
# Get this from: Atlas Dashboard → Database → Connect → Drivers
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name
MONGODB_DB=abc

# Collection name
MONGODB_COLLECTION=abc def
